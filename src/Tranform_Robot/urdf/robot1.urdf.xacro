<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro" name="robot1">

  <!-- Base Link -->
  <link name="robot1_base">
    <visual>
      <geometry>
        <box size="0.4 0.3 0.1"/> <!-- Width, Depth, Height -->
      </geometry>
      <material name="blue">
        <color rgba="0 0 1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.4 0.3 0.1"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.1" ixy="0.0" ixz="0.0"
               iyy="0.1" iyz="0.0"
               izz="0.1"/>
    </inertial>
  </link>

  <!-- Wheels -->
  <xacro:macro name="wheel" params="name x y">
    <link name="${name}">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.02"/>
        </geometry>
        <material name="black">
          <color rgba="0.1 0.1 0.1 1"/>
        </material>
        <origin rpy="1.5708 0 0" xyz="0 0 0"/>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="robot1_base"/>
      <child link="${name}"/>
      <origin xyz="${x} ${y} -0.05" rpy="0 0 0"/>
    </joint>
  </xacro:macro>

  <xacro:wheel name="front_left_wheel"  x="0.15" y=" 0.10"/>
  <xacro:wheel name="front_right_wheel" x="0.15" y="-0.10"/>
  <xacro:wheel name="rear_left_wheel"   x="-0.15" y=" 0.10"/>
  <xacro:wheel name="rear_right_wheel"  x="-0.15" y="-0.10"/>

</robot>
